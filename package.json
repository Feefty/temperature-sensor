{
  "name": "temperature-sensor",
  "version": "1.0.0",
  "description": "Temperature Sensor API following NestJS Hexagonal Architecture",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rm -rf dist src/application/api/api-contract/generated",
    "generate": "openapi-ts",
    "compile": "npm run generate && tsc -p tsconfig.build.json",
    "build": "npm run clean && npm run compile",
    "start": "npm run build && node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "pretest": "npm run generate",
    "test": "jest --config jest.config.ts",
    "test:all": "npm run test && npm run test:api",
    "test:watch": "jest --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:api": "npm run generate && jest --config src/application/api/api-core/test/jest-api.json",
    "test:domain": "npm run generate && jest --config jest.config.ts --testPathPattern=domain",
    "test:infra": "npm run generate && jest --config src/infrastructure/test/jest-infra.json",
    "test:integration": "npm run generate && jest --config src/application/api/api-core/test/jest-api.json --testPathPattern=integration",
    "test:security": "npm run generate && jest --config src/application/api/api-core/test/jest-api.json --testPathPattern=security",
    "lint": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/cqrs": "10.2.8",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "6.3.0",
    "@nestjs/typeorm": "10.0.2",
    "@types/js-yaml": "^4.0.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "8.0.0",
    "js-yaml": "^4.1.0",
    "nestjs-pino": "4.2.0",
    "pg": "8.13.1",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "uuid": "11.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@hey-api/openapi-ts": "^0.95.0",
    "@jest/globals": "29.7.0",
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.15",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "eslint": "9.16.0",
    "eslint-plugin-boundaries": "4.2.2",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "testcontainers": "^10.16.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
