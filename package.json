  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "nodemon --exec \"node --env-file=.env -r ts-node/register\" src/server.ts",
    "test": "jest",
    "migration:seed": "prisma db seed",
    "migration:generate": "prisma migrate dev --create-only --schema=db/prisma.schema",
