# Copy to `.env` for local overrides. When NODE_ENV=development, the app also loads `.env.docker`.
NODE_ENV=development
SERVICE_PORT=3000
SERVICE_HOST=0.0.0.0
API_GLOBAL_PREFIX=api/v1

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_SYNCHRONIZE=false
DATABASE_NAME=temperature_sensor
DATABASE_USER=temperature_sensor
DATABASE_PASSWORD=temperature_sensor
DATABASE_TIMEZONE=Z
DATABASE_WAIT_FOR_CONNECTIONS=true
DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT=10000

DATABASE_LOGGING=false
DATABASE_MIGRATION_RUN=true

SENSOR_THRESHOLD_SINGLETON_KEY=1
SENSOR_HISTORY_SIZE=15
SENSOR_SIMULATED_MIN_CELSIUS=15
SENSOR_SIMULATED_MAX_CELSIUS=40